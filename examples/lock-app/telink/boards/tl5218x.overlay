/ {
	zephyr,user {
		io-channels = <&adc 0>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <24>;
		zephyr,input-positive = <DT_ADC_VBAT>;
	};
};

&power {
	vbat-type = "VBAT_MAX_VALUE_LESS_THAN_3V6";
};
